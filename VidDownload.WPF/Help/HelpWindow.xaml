<ui:FluentWindow x:Class="VidDownload.WPF.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{Binding LocalizedStrings[HelpWindowTitle], FallbackValue=Справка}" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Width="560" Height="720" MinWidth="480" MinHeight="500"
        Icon="/icon.png" ExtendsContentIntoTitleBar="True" KeyDown="OnWindowKeyDown">

    <Grid Background="{DynamicResource WindowBgrBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar Grid.Row="0" Title="{Binding LocalizedStrings[HelpWindowTitle], FallbackValue=Справка}"/>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,12,20,16">

                <!-- 0. О программе (вверху, как в прототипе) -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,12" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="28"
                                           Foreground="{DynamicResource AccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="VidDownload" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource SurfaceBgrElevatedBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontFamily="{StaticResource MonoFont}"
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding LocalizedStrings[HelpAuthorLabel]}" Style="{StaticResource MetaText}"
                                       FontSize="12" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryFlatButton}" Click="Hyperlink_Vk_Click"
                                        Height="30" Padding="12,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Send24" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="Telegram" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryFlatButton}" Click="Hyperlink_Gh_Click"
                                        Height="30" Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Code24" FontSize="13" Margin="0,0,6,0"/>
                                        <TextBlock Text="GitHub" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. Быстрый старт -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceBgrElevatedBrush}" Margin="0,0,10,0">
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding LocalizedStrings[HelpQuickStartTitle]}" Style="{StaticResource SectionLabel}"
                                       FontSize="14" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[HelpQuickStartText]}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19"/>
                    </StackPanel>
                </Border>

                <!-- 2. Очередь и плейлисты -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceBgrElevatedBrush}" Margin="0,0,10,0">
                                <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding LocalizedStrings[HelpQueueTitle]}" Style="{StaticResource SectionLabel}"
                                       FontSize="14" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[HelpQueueText]}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19"/>
                    </StackPanel>
                </Border>

                <!-- 3. Субтитры -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceBgrElevatedBrush}" Margin="0,0,10,0">
                                <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding LocalizedStrings[HelpSubsTitle]}" Style="{StaticResource SectionLabel}"
                                       FontSize="14" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[HelpSubsText]}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19"/>
                    </StackPanel>
                </Border>

                <!-- 4. Конвертер -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceBgrElevatedBrush}" Margin="0,0,10,0">
                                <TextBlock Text="4" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding LocalizedStrings[HelpConverterTitle]}" Style="{StaticResource SectionLabel}"
                                       FontSize="14" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[HelpConverterText]}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19"/>
                    </StackPanel>
                </Border>

                <!-- 5. Горячие клавиши -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,10" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceBgrElevatedBrush}" Margin="0,0,10,0">
                                <TextBlock Text="5" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding LocalizedStrings[HelpHotkeysTitle]}" Style="{StaticResource SectionLabel}"
                                       FontSize="14" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource WindowBgrBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="Enter" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Скачать ссылку из поля ввода" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource WindowBgrBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                <TextBlock Text="Esc" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Отменить активную загрузку" FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 6. Решение проблем -->
                <Border Style="{StaticResource CardSectionBorder}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceBgrElevatedBrush}" Margin="0,0,10,0">
                                <TextBlock Text="6" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding LocalizedStrings[HelpTroubleshootingTitle]}" Style="{StaticResource SectionLabel}"
                                       FontSize="14" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[HelpTroubleshootingText]}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="19"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>



        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="2" Panel.ZIndex="50"/>
    </Grid>
</ui:FluentWindow>
