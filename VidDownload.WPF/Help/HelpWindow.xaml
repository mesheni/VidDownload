<ui:FluentWindow x:Class="VidDownload.WPF.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{Binding LocalizedStrings[HelpWindowTitle], FallbackValue=VidDownload}" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Width="520" Height="470" Icon="/icon.png"
        ExtendsContentIntoTitleBar="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding LocalizedStrings[HelpWindowTitle], FallbackValue=VidDownload}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,20">

                <!-- Логотип и название -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Border CornerRadius="9" Padding="4" Background="{DynamicResource SurfaceBgrBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                        <Image Source="/icon.png" Width="40" Height="40"/>
                    </Border>
                </StackPanel>

                <!-- Автор -->
                <TextBlock Text="{Binding LocalizedStrings[HelpAuthorLabel]}" FontFamily="{StaticResource DisplayFont}" FontSize="15"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>

                <!-- Версия в бейдже -->
                <Border HorizontalAlignment="Center" CornerRadius="{StaticResource PillRadius}" Padding="13,3" Margin="0,8,0,0"
                        Background="{DynamicResource SurfaceBgrElevatedBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12">
                        <Run Text="v"/>
                        <Run Text="{Binding AppVersion, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                </Border>

                <!-- Ссылки -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <ui:Button Appearance="Secondary" Height="32" Padding="12,0" Margin="0,0,8,0" FontSize="12" Click="Hyperlink_Vk_Click"
                               Content="{Binding LocalizedStrings[TelegramLinkText]}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Globe24" FontSize="13"/>
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" Height="32" Padding="12,0" FontSize="12" Click="Hyperlink_Gh_Click"
                               Content="{Binding LocalizedStrings[GitHubLinkText]}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="OpenFolder24" FontSize="13"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <!-- Изображение автора канала -->
                <Border CornerRadius="{StaticResource MediumRadius}" ClipToBounds="True" Margin="0,14,0,0"
                        BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonDown="imgJojack_MouseLeftButtonDown"
                        ToolTip="https://vk.com/jojacki">
                    <Image x:Name="imgJojack" Source="/jojack.jpg" Height="168" Stretch="Uniform"/>
                </Border>

                <ui:ContentDialogHost x:Name="RootContentDialog" Panel.ZIndex="50"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
