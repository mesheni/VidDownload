<ui:FluentWindow x:Class="VidDownload.WPF.HistoryWindow.HistoryWindow"
        x:Name="HistoryWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:VidDownload.WPF.Converters"
        mc:Ignorable="d"
        Title="{Binding LocalizedStrings[HistoryWindowTitle]}" Height="520" Width="920" WindowStartupLocation="CenterScreen"
        Icon="/icon.png" ResizeMode="NoResize" Loaded="OnLoaded"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <converters:DownloadStatusToColorConverter x:Key="StatusColor"/>

        <!-- Заголовок колонки без стандартной сортировочной панели.
             Неявный стиль распространяет его и на filler после последней колонки,
             иначе там торчит светлая системная заглушка. -->
        <Style x:Key="ColumnHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource TextFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Неявный стиль для служебных заголовков GridView (filler справа от колонок) -->
        <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ColumnHeader}"/>
    </Window.Resources>

    <Grid Margin="14,4,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding LocalizedStrings[HistoryWindowTitle]}"/>

        <ui:TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="{Binding LocalizedStrings[HistorySearchPlaceholder]}"
                    MinHeight="32" Margin="0,6,0,0" FontSize="12.5" ClearButtonEnabled="True"
                    AutomationProperties.Name="{Binding LocalizedStrings[HistorySearchPlaceholder]}"/>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" Margin="0,8,0,0">
            <ListView ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry}"
                      BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                      FontSize="13"
                      ItemContainerStyle="{StaticResource HistoryRow}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SizeChanged="OnListViewSizeChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{Binding LocalizedStrings[DateColumn]}" Width="Auto" HeaderContainerStyle="{StaticResource ColumnHeader}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                               Style="{StaticResource HistoryCellText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding LocalizedStrings[UrlNameColumn]}" HeaderContainerStyle="{StaticResource ColumnHeader}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource HistoryCellText}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Binding LocalizedStrings[StatusColumn]}" Width="Auto" HeaderContainerStyle="{StaticResource ColumnHeader}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,1"
                                               Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="" HeaderContainerStyle="{StaticResource ColumnHeader}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="{Binding ElementName=HistoryWin, Path=DataContext.LocalizedStrings[DownloadActionColumn]}"
                                                Command="{Binding ElementName=HistoryWin, Path=DownloadAgainCommand}"
                                                CommandParameter="{Binding}"
                                                MinWidth="96" MinHeight="28" Padding="12,0" Margin="0,2"
                                                FontSize="12" HorizontalAlignment="Center"/>
                                        <Button Style="{StaticResource QueueGhostButton}" Content="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                Command="{Binding ElementName=HistoryWin, Path=DataContext.OpenEntryFileCommand}" CommandParameter="{Binding}" Margin="2,2"
                                                AutomationProperties.Name="{Binding ElementName=HistoryWin, Path=DataContext.LocalizedStrings[HistoryOpenFileButton]}"
                                                ToolTip="{Binding ElementName=HistoryWin, Path=DataContext.LocalizedStrings[HistoryOpenFileButton]}"/>
                                        <Button Style="{StaticResource QueueGhostButton}" Content="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                Command="{Binding ElementName=HistoryWin, Path=DataContext.OpenEntryFolderCommand}" CommandParameter="{Binding}" Margin="2,2"
                                                AutomationProperties.Name="{Binding ElementName=HistoryWin, Path=DataContext.LocalizedStrings[HistoryOpenFolderButton]}"
                                                ToolTip="{Binding ElementName=HistoryWin, Path=DataContext.LocalizedStrings[HistoryOpenFolderButton]}"/>
                                        <Button Style="{StaticResource QueueGhostButton}" Content="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                                Command="{Binding ElementName=HistoryWin, Path=DataContext.RemoveEntryCommand}" CommandParameter="{Binding}" Margin="2,2"
                                                AutomationProperties.Name="{Binding ElementName=HistoryWin, Path=DataContext.LocalizedStrings[HistoryRemoveEntryButton]}"
                                                ToolTip="{Binding ElementName=HistoryWin, Path=DataContext.LocalizedStrings[HistoryRemoveEntryButton]}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:Button Content="{Binding LocalizedStrings[ClearHistoryButton]}" Command="{Binding ClearHistoryCommand}"
                       Appearance="Danger" MinWidth="150" Height="34" FontSize="13"/>
            <ui:Button Grid.Column="2" Content="{Binding LocalizedStrings[CloseButton]}" Click="CloseButton_Click"
                       Appearance="Secondary" MinWidth="110" Height="34" FontSize="13"/>
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="4" Panel.ZIndex="50"/>
    </Grid>
</ui:FluentWindow>
