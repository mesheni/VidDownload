<ui:FluentWindow x:Class="VidDownload.WPF.SettingsWindow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:VidDownload.WPF.Converters"
        mc:Ignorable="d"
        Title="{Binding LocalizedStrings[SettingsWindowTitle]}" Width="500" Height="640"
        MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowBackdropType="Mica" Icon="/icon.png"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="TextToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding LocalizedStrings[SettingsWindowTitle]}"/>

        <Grid Grid.Row="1" Margin="16,4,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4,0,0">

                    <!-- Приложение -->
                    <ui:CardExpander Margin="0,0,0,8" Padding="14,9" ContentPadding="14,0,14,8"
                                     Background="{DynamicResource SurfaceBgrBrush}"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CornerRadius="{StaticResource MediumRadius}" IsExpanded="True">
                        <ui:CardExpander.Header>
                            <TextBlock Text="{Binding LocalizedStrings[SettingsAppSection]}"
                                       FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                <TextBlock Text="{Binding LocalizedStrings[LanguageLabel]}" Style="{StaticResource FieldLabelText}"
                                           Width="148" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                          Width="110" MinHeight="30" FontSize="{StaticResource FontSizeBody}"
                                          AutomationProperties.Name="{Binding LocalizedStrings[LanguageLabel]}"/>
                            </StackPanel>

                            <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray}" Content="{Binding LocalizedStrings[MinimizeToTrayLabel]}"
                                             FontSize="{StaticResource FontSizeBody}" Margin="2,2"/>
                            <ui:ToggleSwitch IsChecked="{Binding ClipboardMonitorEnabled}" Content="{Binding LocalizedStrings[ClipboardMonitorLabel]}"
                                             FontSize="{StaticResource FontSizeBody}" Margin="2,2"/>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Загрузки -->
                    <ui:CardExpander Margin="0,0,0,8" Padding="14,9" ContentPadding="14,0,14,8"
                                     Background="{DynamicResource SurfaceBgrBrush}"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CornerRadius="{StaticResource MediumRadius}" IsExpanded="True">
                        <ui:CardExpander.Header>
                            <TextBlock Text="{Binding LocalizedStrings[SettingsDownloadsSection]}"
                                       FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                <TextBlock Text="{Binding LocalizedStrings[MaxConcurrentLabel]}" Style="{StaticResource FieldLabelText}"
                                           Width="148" VerticalAlignment="Center"/>
                                <ui:NumberBox Value="{Binding MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}" Width="92" MinHeight="30"
                                              Minimum="1" Maximum="3" SmallChange="1" ClearButtonEnabled="False" FontSize="{StaticResource FontSizeBody}"
                                              AutomationProperties.Name="{Binding LocalizedStrings[MaxConcurrentLabel]}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LocalizedStrings[MaxConcurrentHint]}" Style="{StaticResource FieldHintText}"
                                       TextWrapping="Wrap" Margin="2,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="{Binding LocalizedStrings[RetriesLabel]}" Style="{StaticResource FieldLabelText}"
                                           Width="148" VerticalAlignment="Center"/>
                                <ui:NumberBox Value="{Binding Retries, UpdateSourceTrigger=PropertyChanged}" Width="92" MinHeight="30"
                                              Minimum="0" Maximum="20" SmallChange="1" ClearButtonEnabled="False" FontSize="{StaticResource FontSizeBody}"
                                              AutomationProperties.Name="{Binding LocalizedStrings[RetriesLabel]}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LocalizedStrings[RetriesHint]}" Style="{StaticResource FieldHintText}"
                                       TextWrapping="Wrap" Margin="2,0,0,6"/>

                            <ui:ToggleSwitch IsChecked="{Binding UseDownloadArchive}" Content="{Binding LocalizedStrings[UseArchiveLabel]}"
                                             FontSize="{StaticResource FontSizeBody}" Margin="2,4,2,2"/>
                            <TextBlock Text="{Binding LocalizedStrings[UseArchiveHint]}" Style="{StaticResource FieldHintText}"
                                       TextWrapping="Wrap" Margin="2,0,0,8"/>

                            <ui:ToggleSwitch IsChecked="{Binding ShowMetadataPreview}" Content="{Binding LocalizedStrings[ShowPreviewLabel]}"
                                             FontSize="{StaticResource FontSizeBody}" Margin="2,4,2,2"/>
                            <TextBlock Text="{Binding LocalizedStrings[ShowPreviewHint]}" Style="{StaticResource FieldHintText}"
                                       TextWrapping="Wrap" Margin="2,0,0,2"/>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Сеть и приватность -->
                    <ui:CardExpander Margin="0,0,0,8" Padding="14,9" ContentPadding="14,0,14,8"
                                     Background="{DynamicResource SurfaceBgrBrush}"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CornerRadius="{StaticResource MediumRadius}" IsExpanded="True">
                        <ui:CardExpander.Header>
                            <TextBlock Text="{Binding LocalizedStrings[SettingsNetworkPrivacySection]}"
                                       FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                <TextBlock Text="{Binding LocalizedStrings[ProxyLabel]}" Style="{StaticResource FieldLabelText}"
                                           Width="148" VerticalAlignment="Center"/>
                                <ui:TextBox x:Name="ProxyBox" Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" Width="230" MinHeight="30"
                                            FontSize="{StaticResource FontSizeBody}"
                                            FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"
                                            PlaceholderText="socks5://127.0.0.1:1080"
                                            AutomationProperties.Name="{Binding LocalizedStrings[ProxyLabel]}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LocalizedStrings[ProxyHint]}" Style="{StaticResource FieldHintText}"
                                       TextWrapping="Wrap" Margin="2,0,0,4"/>
                            <TextBlock Text="{Binding ProxyError}" Style="{StaticResource ErrorText}"
                                       TextWrapping="Wrap" Margin="2,0,0,8"
                                       Visibility="{Binding ProxyError, Converter={StaticResource TextToVis}}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="{Binding LocalizedStrings[CookiesSourceLabel]}" Style="{StaticResource FieldLabelText}"
                                           Width="148" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding CookiesSources}" SelectedIndex="{Binding SelectedCookiesIndex}"
                                          Width="160" MinHeight="30" FontSize="{StaticResource FontSizeBody}"
                                          AutomationProperties.Name="{Binding LocalizedStrings[CookiesSourceLabel]}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LocalizedStrings[CookiesHint]}" Style="{StaticResource FieldHintText}"
                                       TextWrapping="Wrap" Margin="2,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2"
                                        Visibility="{Binding IsCookiesFileSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LocalizedStrings[CookiesFileLabel]}" Style="{StaticResource FieldLabelText}"
                                           Width="148" VerticalAlignment="Center"/>
                                <ui:TextBox x:Name="CookiesFileBox" Text="{Binding CookiesFilePath, UpdateSourceTrigger=PropertyChanged}"
                                            Width="152" MinHeight="30" FontSize="{StaticResource FontSizeCaption}"
                                            FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"
                                            AutomationProperties.Name="{Binding LocalizedStrings[CookiesFileLabel]}"/>
                                <Button Content="{Binding LocalizedStrings[BrowseButton]}" Command="{Binding BrowseCookiesFileCommand}"
                                        MinHeight="30" Padding="10,0" Margin="6,0,0,0" FontSize="{StaticResource FontSizeCaption}"
                                        AutomationProperties.Name="{Binding LocalizedStrings[BrowseButton]}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CookiesFileError}" Style="{StaticResource ErrorText}"
                                       TextWrapping="Wrap" Margin="2,0,0,2"
                                       Visibility="{Binding CookiesFileError, Converter={StaticResource TextToVis}}"/>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Диагностика -->
                    <ui:CardControl Margin="0,0,0,8" Padding="14,10"
                                    Background="{DynamicResource SurfaceBgrBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    CornerRadius="{StaticResource MediumRadius}"
                                    Icon="{ui:SymbolIcon FolderOpen24}">
                        <ui:CardControl.Header>
                            <TextBlock Text="{Binding LocalizedStrings[SettingsDiagnosticsSection]}"
                                       FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ui:CardControl.Header>
                        <ui:CardControl.Content>
                            <ui:Button Appearance="Secondary" Command="{Binding OpenLogsFolderCommand}" Height="32"
                                       FontSize="{StaticResource FontSizeBody}"
                                       AutomationProperties.Name="{Binding LocalizedStrings[SettingsOpenLogsFolder]}"
                                       Content="{Binding LocalizedStrings[SettingsOpenLogsFolder]}"/>
                        </ui:CardControl.Content>
                    </ui:CardControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Margin="0,14,0,2">
                <TextBlock Text="{Binding SaveError}" Style="{StaticResource ErrorText}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"
                           Visibility="{Binding SaveError, Converter={StaticResource TextToVis}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <ui:Button Appearance="Primary" Click="OnSaveClick" IsDefault="True" MinWidth="150" Height="40"
                               FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"
                               CornerRadius="{StaticResource PillRadius}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Save24" FontSize="{StaticResource FontSizeBodyLarge}"/>
                        </ui:Button.Icon>
                        <TextBlock Text="{Binding LocalizedStrings[SaveButton]}" Margin="6,0,0,0"/>
                    </ui:Button>
                    <ui:Button Appearance="Secondary" IsCancel="True" MinWidth="130" Height="32"
                               FontSize="{StaticResource FontSizeBody}" Margin="10,0,0,0"
                               Content="{Binding LocalizedStrings[CancelButton]}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="2" Panel.ZIndex="50"/>
    </Grid>
</ui:FluentWindow>
