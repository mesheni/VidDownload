<ui:FluentWindow x:Class="VidDownload.WPF.SettingsWindow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{Binding LocalizedStrings[SettingsWindowTitle]}" Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Icon="/icon.png"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" xmlns:converters="clr-namespace:VidDownload.WPF.Converters"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding LocalizedStrings[SettingsWindowTitle]}"/>

        <Grid Grid.Row="1" Margin="16,4,16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,4,0,0">

            <!-- Приложение -->
            <Border Style="{StaticResource CardBorder}" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="{Binding LocalizedStrings[SettingsAppSection]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <TextBlock Text="{Binding LocalizedStrings[LanguageLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5" Width="148"
                                   VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                  Width="110" MinHeight="30" FontSize="12.5"
                                  AutomationProperties.Name="{Binding LocalizedStrings[LanguageLabel]}"/>
                    </StackPanel>

                    <ui:ToggleSwitch IsChecked="{Binding MinimizeToTray}" Content="{Binding LocalizedStrings[MinimizeToTrayLabel]}" FontSize="13" Margin="2,2"/>
                    <ui:ToggleSwitch IsChecked="{Binding ClipboardMonitorEnabled}" Content="{Binding LocalizedStrings[ClipboardMonitorLabel]}" FontSize="13" Margin="2,2"/>
                </StackPanel>
            </Border>

            <!-- Загрузки -->
            <Border Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LocalizedStrings[SettingsDownloadsSection]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,2">
                        <TextBlock Text="{Binding LocalizedStrings[MaxConcurrentLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5" Width="148"
                                   VerticalAlignment="Center" ToolTip="{Binding LocalizedStrings[MaxConcurrentHint]}"/>
                        <ui:NumberBox Value="{Binding MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}" Width="92" MinHeight="30"
                                      Minimum="1" Maximum="3" SmallChange="1" ClearButtonEnabled="False" FontSize="12.5"
                                      ToolTip="{Binding LocalizedStrings[MaxConcurrentHint]}"
                                      AutomationProperties.Name="{Binding LocalizedStrings[MaxConcurrentLabel]}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,6,0,2">
                        <TextBlock Text="{Binding LocalizedStrings[RetriesLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5" Width="148"
                                   VerticalAlignment="Center" ToolTip="{Binding LocalizedStrings[RetriesHint]}"/>
                        <ui:NumberBox Value="{Binding Retries, UpdateSourceTrigger=PropertyChanged}" Width="92" MinHeight="30"
                                      Minimum="0" Maximum="20" SmallChange="1" ClearButtonEnabled="False" FontSize="12.5"
                                      ToolTip="{Binding LocalizedStrings[RetriesHint]}"
                                      AutomationProperties.Name="{Binding LocalizedStrings[RetriesLabel]}"/>
                    </StackPanel>
                    <ui:ToggleSwitch IsChecked="{Binding UseDownloadArchive}" Content="{Binding LocalizedStrings[UseArchiveLabel]}" FontSize="13" Margin="2,4"
                                     ToolTip="{Binding LocalizedStrings[UseArchiveHint]}"/>
                </StackPanel>
            </Border>

            <!-- Сеть -->
            <Border Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LocalizedStrings[SettingsNetworkSection]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>

                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <TextBlock Text="{Binding LocalizedStrings[ProxyLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5" Width="148"
                                   VerticalAlignment="Center"/>
                        <ui:TextBox Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}" Width="230" MinHeight="30" FontSize="12"
                                    FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"
                                    PlaceholderText="socks5://127.0.0.1:1080"
                                    AutomationProperties.Name="{Binding LocalizedStrings[ProxyLabel]}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <TextBlock Text="{Binding LocalizedStrings[CookiesSourceLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5" Width="148"
                                   VerticalAlignment="Center" ToolTip="{Binding LocalizedStrings[CookiesHint]}"/>
                        <ComboBox ItemsSource="{Binding CookiesSources}" SelectedIndex="{Binding SelectedCookiesIndex}"
                                  Width="160" MinHeight="30" FontSize="12.5"
                                  ToolTip="{Binding LocalizedStrings[CookiesHint]}"
                                  AutomationProperties.Name="{Binding LocalizedStrings[CookiesSourceLabel]}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="2,0,0,2"
                                Visibility="{Binding IsCookiesFileSelected, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="cookies.txt" Style="{StaticResource FieldLabelText}" FontSize="12" Width="148" VerticalAlignment="Center"/>
                        <ui:TextBox Text="{Binding CookiesFilePath, UpdateSourceTrigger=PropertyChanged}" Width="152" MinHeight="29" FontSize="11.5"
                                    FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"/>
                        <Button Content="{Binding LocalizedStrings[BrowseButton]}" Command="{Binding BrowseCookiesFileCommand}"
                                MinHeight="29" Padding="10,0" Margin="6,0,0,0" FontSize="12"/>
                    </StackPanel>

                    <TextBlock Text="{Binding LocalizedStrings[CookiesHint]}" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Диагностика -->
            <Border Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding LocalizedStrings[SettingsDiagnosticsSection]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                    <ui:Button Appearance="Secondary" Command="{Binding OpenLogsFolderCommand}" Height="34" MinWidth="210" FontSize="12.5" HorizontalAlignment="Left">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14"/>
                        </ui:Button.Icon>
                        <TextBlock Text="{Binding LocalizedStrings[SettingsOpenLogsFolder]}" Margin="6,0,0,0"/>
                    </ui:Button>
                </StackPanel>
            </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Кнопки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,2">
                <ui:Button Appearance="Primary" Click="OnSaveClick" MinWidth="150" Height="38" FontSize="13" FontWeight="SemiBold" CornerRadius="19">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" FontSize="15"/>
                    </ui:Button.Icon>
                    <TextBlock Text="{Binding LocalizedStrings[SaveButton]}" Margin="6,0,0,0"/>
                </ui:Button>
                <ui:Button Appearance="Secondary" Click="CancelButton_Click" MinWidth="130" Height="38" FontSize="13" Margin="10,0,0,0">
                    <TextBlock Text="{Binding LocalizedStrings[CloseButton]}"/>
                </ui:Button>
            </StackPanel>
        </Grid>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="2" Panel.ZIndex="50"/>
    </Grid>
</ui:FluentWindow>
