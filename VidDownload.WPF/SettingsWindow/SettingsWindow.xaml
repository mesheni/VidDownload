<ui:FluentWindow x:Class="VidDownload.WPF.SettingsWindow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:VidDownload.WPF.Converters"
        mc:Ignorable="d"
        Title="{Binding LocalizedStrings[SettingsWindowTitle]}" Width="520" Height="720"
        MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Icon="/icon.png" ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="TextToVis"/>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBgrBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <ui:TitleBar Grid.Row="0" Title="{Binding LocalizedStrings[SettingsWindowTitle]}"/>

        <!-- Содержимое настроек -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,12,20,16">

                <!-- 1. ПРИЛОЖЕНИЕ -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,12" Padding="16,8,16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[SettingsAppSection]}" Style="{StaticResource SectionLabel}"
                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,8"/>

                        <!-- Язык -->
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LocalizedStrings[LanguageLabel]}" Style="{StaticResource FieldLabelText}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                      Width="120" MinHeight="32" AutomationProperties.Name="{Binding LocalizedStrings[LanguageLabel]}"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                        <!-- Сворачивать в трей -->
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LocalizedStrings[MinimizeToTrayLabel]}" Style="{StaticResource FieldLabelText}"
                                       VerticalAlignment="Center"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                        <!-- Буфер обмена -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LocalizedStrings[ClipboardMonitorLabel]}" Style="{StaticResource FieldLabelText}"
                                       VerticalAlignment="Center"/>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ClipboardMonitorEnabled}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 2. ЗАГРУЗКИ -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,12" Padding="16,8,16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[SettingsDownloadsSection]}" Style="{StaticResource SectionLabel}"
                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,8"/>

                        <!-- Одновременных загрузок -->
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LocalizedStrings[MaxConcurrentLabel]}" Style="{StaticResource FieldLabelText}"
                                       VerticalAlignment="Center"/>
                            <ui:NumberBox Grid.Column="1" Value="{Binding MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}"
                                          Width="120" Height="32" Minimum="1" Maximum="3" SmallChange="1" ClearButtonEnabled="False"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                        <!-- Повторов при ошибке -->
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LocalizedStrings[RetriesLabel]}" Style="{StaticResource FieldLabelText}"
                                       VerticalAlignment="Center"/>
                            <ui:NumberBox Grid.Column="1" Value="{Binding Retries, UpdateSourceTrigger=PropertyChanged}"
                                          Width="120" Height="32" Minimum="0" Maximum="20" SmallChange="1" ClearButtonEnabled="False"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                        <!-- Архив загрузок -->
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding LocalizedStrings[UseArchiveLabel]}" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding LocalizedStrings[UseArchiveHint]}" Style="{StaticResource FieldHintText}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UseDownloadArchive}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                        <!-- Окно предпросмотра -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding LocalizedStrings[ShowPreviewLabel]}" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Text="{Binding LocalizedStrings[ShowPreviewHint]}" Style="{StaticResource FieldHintText}"
                                           TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowMetadataPreview}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. СЕТЬ И ПРИВАТНОСТЬ -->
                <Border Style="{StaticResource CardSectionBorder}" Margin="0,0,0,12" Padding="16,8,16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[SettingsNetworkPrivacySection]}" Style="{StaticResource SectionLabel}"
                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,8"/>

                        <!-- Прокси -->
                        <DockPanel LastChildFill="True" Margin="0,6,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizedStrings[ProxyLabel]}" Style="{StaticResource FieldLabelText}"
                                       Width="120" VerticalAlignment="Center"/>
                            <ui:TextBox x:Name="ProxyBox" Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}"
                                        Height="32" PlaceholderText="{Binding LocalizedStrings[ProxyPlaceholder]}"
                                        FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding ProxyError}" Style="{StaticResource ErrorText}" Margin="120,-6,0,8"
                                   Visibility="{Binding HasProxyError, Converter={StaticResource BoolToVis}}"/>

                        <Border BorderBrush="{DynamicResource AppBorderSubtleBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>

                        <!-- Cookies источник -->
                        <DockPanel LastChildFill="True" Margin="0,6,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding LocalizedStrings[CookiesSourceLabel]}" Style="{StaticResource FieldLabelText}"
                                       Width="120" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding CookiesSources}" SelectedIndex="{Binding SelectedCookiesIndex}"
                                      Height="32" HorizontalAlignment="Stretch"/>
                        </DockPanel>

                        <!-- Файл cookies.txt -->
                        <DockPanel LastChildFill="True" Margin="0,0,0,8" Visibility="{Binding IsCookiesFileRequired, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Left" Text="cookies.txt" FontFamily="{StaticResource MonoFont}"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Width="120" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryFlatButton}"
                                    Content="{Binding LocalizedStrings[BrowseButton]}" Margin="8,0,0,0"
                                    Command="{Binding BrowseCookiesFileCommand}" Height="32" Padding="14,0"/>
                            <ui:TextBox x:Name="CookiesFileBox" Text="{Binding CookiesFilePath, UpdateSourceTrigger=PropertyChanged}"
                                        Height="32" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding CookiesFileError}" Style="{StaticResource ErrorText}" Margin="120,-4,0,8"
                                   Visibility="{Binding HasCookiesFileError, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{Binding LocalizedStrings[CookiesHint]}" Style="{StaticResource FieldHintText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 4. ДИАГНОСТИКА -->
                <Border Style="{StaticResource CardSectionBorder}" Padding="16,8,16,14">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[SettingsDiagnosticsSection]}" Style="{StaticResource SectionLabel}"
                                   FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,10"/>
                        <Button Style="{StaticResource SecondaryFlatButton}" HorizontalAlignment="Left"
                                Command="{Binding OpenLogsFolderCommand}" Height="34" Padding="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Folder24" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding LocalizedStrings[OpenLogsFolderButton]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель действий -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBgrBrush}" BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                BorderThickness="0,1,0,0" Padding="20,12,20,14">
            <StackPanel>
                <TextBlock Text="{Binding SaveError}" Style="{StaticResource ErrorText}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"
                           Visibility="{Binding SaveError, Converter={StaticResource TextToVis}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource AccentPillButton}" Click="OnSaveClick" IsDefault="True"
                            Height="38" MinWidth="150" Padding="20,0" FontSize="13.5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LocalizedStrings[SaveButton]}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryFlatButton}" IsCancel="True"
                            Height="38" MinWidth="110" Padding="18,0" Margin="10,0,0,0"
                            Content="{Binding LocalizedStrings[CancelButton]}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="3" Panel.ZIndex="50"/>
    </Grid>
</ui:FluentWindow>
