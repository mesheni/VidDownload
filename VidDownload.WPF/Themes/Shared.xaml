<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Общие токены дизайна VidDownload: шрифты, размеры текста, радиусы, акцент и статусы. -->

    <!-- Шрифты -->
    <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Code, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="MonoLightFont">JetBrains Mono, Cascadia Code SemiLight, Cascadia Code, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="TextFont">Inter, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="DisplayFont">Inter, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>

    <!-- Размеры текста -->
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">14</sys:Double>
    <sys:Double x:Key="FontSizeTitle">20</sys:Double>

    <!-- Радиусы скругления (из дизайн-макетов 2026) -->
    <CornerRadius x:Key="SmallRadius">6</CornerRadius>
    <CornerRadius x:Key="MediumRadius">10</CornerRadius>
    <CornerRadius x:Key="LargeRadius">14</CornerRadius>
    <CornerRadius x:Key="PillRadius">24</CornerRadius>

    <!-- Акцент: кораллово-красный VidDownload (#FF4F4F) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF4F4F"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#E54040"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0A1424"/>

    <!-- Статусные цвета очереди/истории (полосы и заливка прогресса) -->
    <SolidColorBrush x:Key="StatusQueuedBrush" Color="#8C93A0"/>
    <SolidColorBrush x:Key="StatusDownloadingBrush" Color="#5B9DFF"/>
    <SolidColorBrush x:Key="StatusPausedBrush" Color="#E5B04A"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#4FC58A"/>
    <SolidColorBrush x:Key="StatusFailedBrush" Color="#F0716B"/>
    <SolidColorBrush x:Key="StatusCancelledBrush" Color="#8C93A0"/>
</ResourceDictionary>