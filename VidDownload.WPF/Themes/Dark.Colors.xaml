<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тёмная палитра приложения VidDownload (новый дизайн 2026).
         Ключи синхронизированы со Light.Colors.xaml. -->

    <SolidColorBrush x:Key="WindowBgrBrush" Color="#16171B"/>
    <SolidColorBrush x:Key="SidebarBgrBrush" Color="#1B1C21"/>
    <SolidColorBrush x:Key="SurfaceBgrBrush" Color="#202228"/>
    <SolidColorBrush x:Key="SurfaceBgrAltBrush" Color="#1B1C21"/>
    <SolidColorBrush x:Key="SurfaceBgrElevatedBrush" Color="#262932"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#2F323A"/>
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#272A31"/>
    <SolidColorBrush x:Key="LineBrush" Color="#343841"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEEF2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A3A9B5"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8C93A0"/>

    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF4F4F"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#0A1424"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#5B9DFF"/>

    <SolidColorBrush x:Key="StatusFailedTextBrush" Color="#F0716B"/>
    <SolidColorBrush x:Key="StatusDownloadingTextBrush" Color="#5B9DFF"/>
    <SolidColorBrush x:Key="StatusPausedTextBrush" Color="#E5B04A"/>
    <SolidColorBrush x:Key="StatusCompletedTextBrush" Color="#4FC58A"/>

    <SolidColorBrush x:Key="ButtonGrayBrush" Color="#272A31"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2C2F37"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#23262D"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#B0000000"/>
</ResourceDictionary>