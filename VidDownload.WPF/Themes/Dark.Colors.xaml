<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тёмная палитра приложения (Fluent-совместимая).
         Ключи синхронизированы со Light.Colors.xaml. -->

    <SolidColorBrush x:Key="WindowBgrBrush" Color="#202020"/>
    <SolidColorBrush x:Key="SurfaceBgrBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SurfaceBgrAltBrush" Color="#303030"/>
    <SolidColorBrush x:Key="SurfaceBgrElevatedBrush" Color="#353535"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#16323232"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="LineBrush" Color="#4D4D4D"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#767676"/>

    <SolidColorBrush x:Key="ButtonGrayBrush" Color="#404040"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#90000000"/>
</ResourceDictionary>
