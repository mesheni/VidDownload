<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Тёмная палитра приложения (Fluent-совместимая).
         Ключи синхронизированы со Light.Colors.xaml.
         Контраст WCAG (relative luminance), вычислено скриптом:
           TextMuted #A6A6A6 / Window #202020        6.69
           TextMuted #A6A6A6 / Surface #2A2A2A       5.90
           TextMuted #A6A6A6 / Elevated #3C3C3C      4.53
           Elevated #3C3C3C / Surface #2A2A2A        1.30
           StatusFailedText #FF6B6B / Surface        5.17
           StatusDownloadingText #82AFFF / Surface   6.51
           StatusPausedText #FFB020 / Surface        7.85
           StatusCompletedText #7BE0A0 / Surface     8.89
           AccentText #FF8A8A / Surface              6.33
           FocusRing #FF7A7A / Surface               5.68
           FocusRing #FF7A7A / Elevated              4.37
           SubtleFill (blend) / Surface              1.41
           StatusFailed #EF5350 / Surface            4.12 (полоса >= 3:1) -->

    <SolidColorBrush x:Key="WindowBgrBrush" Color="#202020"/>
    <SolidColorBrush x:Key="SurfaceBgrBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="SurfaceBgrAltBrush" Color="#303030"/>
    <SolidColorBrush x:Key="SurfaceBgrElevatedBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="LineBrush" Color="#4D4D4D"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B4B4B4"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A6A6A6"/>

    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF8A8A"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FF7A7A"/>

    <SolidColorBrush x:Key="StatusFailedTextBrush" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="StatusDownloadingTextBrush" Color="#82AFFF"/>
    <SolidColorBrush x:Key="StatusPausedTextBrush" Color="#FFB020"/>
    <SolidColorBrush x:Key="StatusCompletedTextBrush" Color="#7BE0A0"/>

    <SolidColorBrush x:Key="ButtonGrayBrush" Color="#404040"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#90000000"/>
</ResourceDictionary>
