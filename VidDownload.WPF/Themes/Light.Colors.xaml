<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Светлая палитра приложения (Fluent-совместимая).
         Ключи синхронизированы с Dark.Colors.xaml. -->

    <SolidColorBrush x:Key="WindowBgrBrush" Color="#F4F4F4"/>
    <SolidColorBrush x:Key="SurfaceBgrBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBgrAltBrush" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="SurfaceBgrElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#DEDEDE"/>
    <SolidColorBrush x:Key="LineBrush" Color="#C8C8C8"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#161616"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#585858"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#868686"/>

    <SolidColorBrush x:Key="ButtonGrayBrush" Color="#E9E9E9"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#50000000"/>
</ResourceDictionary>
