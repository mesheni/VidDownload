<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Светлая палитра приложения VidDownload (новый дизайн 2026).
         Ключи синхронизированы со Dark.Colors.xaml. -->

    <SolidColorBrush x:Key="WindowBgrBrush" Color="#F5F4EF"/>
    <SolidColorBrush x:Key="SidebarBgrBrush" Color="#ECEAE2"/>
    <SolidColorBrush x:Key="SurfaceBgrBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBgrAltBrush" Color="#F7F6F2"/>
    <SolidColorBrush x:Key="SurfaceBgrElevatedBrush" Color="#E5E2D8"/>
    <SolidColorBrush x:Key="SubtleFillBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#DCD8CC"/>
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#E8E5DD"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D0CCC0"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1E1D"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B6A68"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8C8A85"/>

    <SolidColorBrush x:Key="AccentTextBrush" Color="#E03A3E"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#2563EB"/>

    <SolidColorBrush x:Key="StatusFailedTextBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="StatusDownloadingTextBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="StatusPausedTextBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="StatusCompletedTextBrush" Color="#16A34A"/>

    <SolidColorBrush x:Key="ButtonGrayBrush" Color="#E4E1D6"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#DCD8CC"/>
    <SolidColorBrush x:Key="NavHoverBrush" Color="#E0DCD0"/>
    <SolidColorBrush x:Key="OverlayBackdropBrush" Color="#60000000"/>
</ResourceDictionary>