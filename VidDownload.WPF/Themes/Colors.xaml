<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Общая палитра приложения: industrial/utilitarian, тёмная тема, красный акцент.
         Значения статусов синхронизированы с Themes/StatusPalette.cs (для конвертеров). -->

    <SolidColorBrush x:Key="WindowBgrBrush" Color="#1D1D1D"/>
    <SolidColorBrush x:Key="SurfaceBgrBrush" Color="#262626"/>
    <SolidColorBrush x:Key="SurfaceBgrAltBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="SurfaceBgrElevatedBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="LineBrush" Color="#555555"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6A6A6A"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#FF5252"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#BB1818"/>
    <SolidColorBrush x:Key="ButtonGrayBrush" Color="#444444"/>

    <SolidColorBrush x:Key="StatusQueuedBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="StatusDownloadingBrush" Color="#42A5F5"/>
    <SolidColorBrush x:Key="StatusPausedBrush" Color="#FB8C00"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="StatusFailedBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="StatusCancelledBrush" Color="#757575"/>

    <FontFamily x:Key="MonoFont">Cascadia Code</FontFamily>
    <FontFamily x:Key="MonoLightFont">Cascadia Code SemiLight</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>
</ResourceDictionary>
