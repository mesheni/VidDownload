<ui:FluentWindow x:Class="VidDownload.WPF.ConvertWindow.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:VidDownload.WPF.Converters"
        mc:Ignorable="d"
        Title="{Binding LocalizedStrings[ConvertWindowTitle]}" Width="820" Height="760" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowBackdropType="Mica" Icon="/icon.png"
        ExtendsContentIntoTitleBar="True"
        AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <converters:BooleanInvertConverter x:Key="InvertBool"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="TextToVis"/>
    </Window.Resources>

    <!-- TitleBar вне сетки с полями: системные кнопки прижаты к правому краю окна;
         карточки в ScrollViewer (в пакетном режиме прокручиваются),
         прогресс и кнопки — в отдельной строке, всегда прижаты к низу окна -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding LocalizedStrings[ConvertWindowTitle]}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,4,16,10">

                <!-- Режим -->
                <Border Style="{StaticResource CardBorder}" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch IsChecked="{Binding IsAudioOnlyMode}" Content="{Binding LocalizedStrings[AudioOnlyModeLabel]}" FontSize="{StaticResource FontSizeBody}" Margin="0,0,26,0"
                                         IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                        <ui:ToggleSwitch IsChecked="{Binding IsBatchMode}" Content="{Binding LocalizedStrings[BatchModeLabel]}" FontSize="{StaticResource FontSizeBody}"
                                         IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                    </StackPanel>
                </Border>

                <!-- Источник: один файл -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0" Visibility="{Binding ShowSingleInput, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding LocalizedStrings[InputSectionLabel]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                            <Button DockPanel.Dock="Right" Content="{Binding LocalizedStrings[BrowseButton]}"
                                    Command="{Binding BrowseFileCommand}" MinWidth="100" MinHeight="30" Margin="8,0,0,0" FontSize="{StaticResource FontSizeBody}"
                                    IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                            <TextBox Text="{Binding FilePath}" MinHeight="30" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeBody}"
                                     AutomationProperties.Name="{Binding LocalizedStrings[InputSectionLabel]}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding LocalizedStrings[ConvertDropHint]}" Style="{StaticResource FieldHintText}"
                                   FontSize="{StaticResource FontSizeCaption}" Margin="2,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Источник: пакет -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0" Visibility="{Binding ShowBatchInput, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="2,0,0,6">
                            <TextBlock Text="{Binding LocalizedStrings[InputSectionLabel]}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding LocalizedStrings[BatchAddButton]}" Command="{Binding AddBatchFilesCommand}"
                                        MinHeight="28" Padding="10,0" Margin="0,0,6,0" FontSize="{StaticResource FontSizeBody}"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                                <Button Content="{Binding LocalizedStrings[BatchRemoveButton]}" Command="{Binding RemoveBatchFileCommand}"
                                        MinHeight="28" Padding="10,0" Margin="0,0,6,0" FontSize="{StaticResource FontSizeBody}"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                                <Button Content="{Binding LocalizedStrings[BatchClearButton]}" Command="{Binding ClearBatchFilesCommand}"
                                        MinHeight="28" Padding="10,0" FontSize="{StaticResource FontSizeBody}"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding BatchFiles}" SelectedItem="{Binding SelectedBatchFile}" Height="128"
                                 Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        <TextBlock Text="{Binding LocalizedStrings[ConvertDropHintBatch]}" Style="{StaticResource FieldHintText}"
                                   FontSize="{StaticResource FontSizeCaption}" Margin="2,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Назначение -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[OutputSectionLabel]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding LocalizedStrings[OutputBrowseButton]}"
                                    Command="{Binding BrowseOutputDirCommand}" MinWidth="120" MinHeight="30" Margin="8,0,0,0" FontSize="{StaticResource FontSizeBody}"
                                    IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                            <TextBox Text="{Binding OutputDirectory}" MinHeight="30" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeBody}"
                                     AutomationProperties.Name="{Binding LocalizedStrings[OutputSectionLabel]}"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                    Visibility="{Binding ShowOutputFileName, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LocalizedStrings[OutputFileNameLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}" Width="128"/>
                            <TextBox Text="{Binding OutputFileName}" Width="222" MinHeight="29" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeBody}"
                                     AutomationProperties.Name="{Binding LocalizedStrings[OutputFileNameLabel]}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Кодирование: базовые параметры всегда на виду -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[EncodingSectionLabel]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock Text="{Binding LocalizedStrings[ExtensionLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}"/>
                            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                                      IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" FontSize="{StaticResource FontSizeBody}"
                                      AutomationProperties.Name="{Binding LocalizedStrings[ExtensionLabel]}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowVideoEncoding, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="{Binding LocalizedStrings[VideoCodecLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}"/>
                                <ComboBox ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding SelectedVideoCodec}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" MinWidth="172" FontSize="{StaticResource FontSizeBody}"
                                          AutomationProperties.Name="{Binding LocalizedStrings[VideoCodecLabel]}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LocalizedStrings[AudioCodecLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}"/>
                                <ComboBox ItemsSource="{Binding AudioCodecs}" SelectedItem="{Binding SelectedAudioCodec}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" MinWidth="124" FontSize="{StaticResource FontSizeBody}"
                                          AutomationProperties.Name="{Binding LocalizedStrings[AudioCodecLabel]}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Дополнительные параметры кодирования: свёрнуты, чтобы не перегружать форму -->
                <ui:CardExpander Margin="0,8,0,0" Padding="14,9" ContentPadding="14,0,14,10"
                                 Background="{DynamicResource SurfaceBgrBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" CornerRadius="{StaticResource MediumRadius}"
                                 IsExpanded="{Binding ConvertAdvancedExpanded, Mode=TwoWay}">
                    <ui:CardExpander.Header>
                        <TextBlock Text="{Binding LocalizedStrings[ConvertAdvancedHeader]}"
                                   FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7"
                                    Visibility="{Binding ShowVideoEncoding, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="{Binding LocalizedStrings[HardwareEncoderLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}"/>
                                <ComboBox ItemsSource="{Binding HardwareEncoders}" SelectedItem="{Binding SelectedHardwareEncoder}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" MinWidth="104" FontSize="{StaticResource FontSizeBody}"
                                          AutomationProperties.Name="{Binding LocalizedStrings[HardwareEncoderLabel]}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LocalizedStrings[PresetLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}"/>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" MinWidth="122" FontSize="{StaticResource FontSizeBody}"
                                          AutomationProperties.Name="{Binding LocalizedStrings[PresetLabel]}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- WrapPanel: при минимальной ширине окна поля переносятся на новую строку -->
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,7"
                                        Visibility="{Binding ShowVideoEncoding, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LocalizedStrings[CrfLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}"/>
                                <ui:NumberBox Value="{Binding Crf, UpdateSourceTrigger=PropertyChanged}" Width="auto" MaxWidth="130" MinHeight="29"
                                              Minimum="0" Maximum="51" SmallChange="1" ClearButtonEnabled="False"
                                              IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"
                                              ToolTip="{Binding LocalizedStrings[CrfHint]}"
                                              AutomationProperties.Name="{Binding LocalizedStrings[CrfLabel]}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,7"
                                        Visibility="{Binding ShowVideoEncoding, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LocalizedStrings[VideoBitrateLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}"/>
                                <ui:NumberBox Value="{Binding VideoBitrate, UpdateSourceTrigger=PropertyChanged}" Width="auto" MaxWidth="150" MinHeight="29"
                                              Minimum="0" SmallChange="100" ClearButtonEnabled="False"
                                              IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"
                                              ToolTip="{Binding LocalizedStrings[VideoBitrateHint]}"
                                              AutomationProperties.Name="{Binding LocalizedStrings[VideoBitrateLabel]}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <TextBlock Text="{Binding LocalizedStrings[AudioBitrateLabel]}" Style="{StaticResource FieldLabelText}" FontSize="{StaticResource FontSizeBody}"/>
                                <ui:NumberBox Value="{Binding AudioBitrate, UpdateSourceTrigger=PropertyChanged}" Width="auto" MaxWidth="150" MinHeight="29"
                                              Minimum="0" SmallChange="32" ClearButtonEnabled="False"
                                              IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"
                                              ToolTip="{Binding LocalizedStrings[AudioBitrateHint]}"
                                              AutomationProperties.Name="{Binding LocalizedStrings[AudioBitrateLabel]}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Команда -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[FfmpegCommandPreviewLabel]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding FfmpegCommandPreview}" Height="44" FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource FontSizeCaption}"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="9,7"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="False"
                                 AutomationProperties.Name="{Binding LocalizedStrings[FfmpegCommandPreviewLabel]}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Низ окна: прогресс + кнопки (вне прокрутки, всегда снизу) -->
        <StackPanel Grid.Row="2" Margin="16,8,16,10">
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoLightFont}"
                       FontSize="{StaticResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,2,7"
                       TextWrapping="Wrap" TextAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}"/>

            <!-- Прогресс виден только во время конвертации -->
            <Grid Visibility="{Binding IsConverting, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Style="{StaticResource RoundedProgressBar}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0}%}" Style="{StaticResource MetaText}"
                           MinWidth="38" Margin="8,0,0,0" TextAlignment="Right"/>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,4">
                <Button Content="{Binding LocalizedStrings[CancelConvertButton]}" Command="{Binding CancelConvertCommand}"
                        IsEnabled="{Binding IsCancellable}" Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVis}}"
                        MinWidth="132" Height="38" Margin="0,0,10,0" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold"/>
                <ui:Button Command="{Binding ConvertCommand}" MinWidth="216" Height="40" FontSize="{StaticResource FontSizeBodyLarge}" FontWeight="SemiBold"
                           Appearance="Primary" CornerRadius="{StaticResource PillRadius}" IsDefault="True">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="15"/>
                    </ui:Button.Icon>
                    <TextBlock Text="{Binding LocalizedStrings[ConvertButton]}" Margin="6,0,0,0"/>
                </ui:Button>
            </StackPanel>
        </StackPanel>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="3" Panel.ZIndex="50"/>
    </Grid>
</ui:FluentWindow>
