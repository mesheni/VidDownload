<ui:FluentWindow x:Class="VidDownload.WPF.ConvertWindow.ConvertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:VidDownload.WPF.Converters"
        mc:Ignorable="d"
        Title="{Binding LocalizedStrings[ConvertWindowTitle]}" Width="820" Height="800" MinWidth="820" MinHeight="800" MaxWidth="820" MaxHeight="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop">
    <Window.Resources>
        <converters:BooleanInvertConverter x:Key="InvertBool"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:StringToVisibilityConverter x:Key="TextToVis"/>
    </Window.Resources>

    <!-- TitleBar вне сетки с полями: системные кнопки прижаты к правому краю окна;
         карточки в ScrollViewer (в пакетном режиме прокручиваются),
         прогресс и кнопки — в отдельной строке, всегда прижаты к низу окна -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding LocalizedStrings[ConvertWindowTitle]}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,4,16,10" Height="auto">

                <!-- Режим -->
                <Border Style="{StaticResource CardBorder}" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <ui:ToggleSwitch IsChecked="{Binding IsAudioOnlyMode}" Content="{Binding LocalizedStrings[AudioOnlyModeLabel]}" FontSize="13" Margin="0,0,26,0"/>
                        <ui:ToggleSwitch IsChecked="{Binding IsBatchMode}" Content="{Binding LocalizedStrings[BatchModeLabel]}" FontSize="13"
                                         IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                    </StackPanel>
                </Border>

                <!-- Источник: один файл -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0" Visibility="{Binding ShowSingleInput, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding LocalizedStrings[InputSectionLabel]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                        <Button DockPanel.Dock="Right" Content="{Binding LocalizedStrings[BrowseButton]}"
                                Command="{Binding BrowseFileCommand}" MinWidth="100" MinHeight="30" Margin="8,0,0,0" FontSize="12.5"
                                IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                        <TextBox Text="{Binding FilePath}" MinHeight="30" VerticalContentAlignment="Center"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                    </DockPanel>
                </Border>

                <!-- Источник: пакет -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0" Visibility="{Binding ShowBatchInput, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="2,0,0,6">
                            <TextBlock Text="{Binding LocalizedStrings[InputSectionLabel]}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding LocalizedStrings[BatchAddButton]}" Command="{Binding AddBatchFilesCommand}"
                                        MinHeight="28" Padding="10,0" Margin="0,0,6,0" FontSize="12"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                                <Button Content="{Binding LocalizedStrings[BatchRemoveButton]}" Command="{Binding RemoveBatchFileCommand}"
                                        MinHeight="28" Padding="10,0" Margin="0,0,6,0" FontSize="12"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                                <Button Content="{Binding LocalizedStrings[BatchClearButton]}" Command="{Binding ClearBatchFilesCommand}"
                                        MinHeight="28" Padding="10,0" FontSize="12"
                                        IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                            </StackPanel>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding BatchFiles}" SelectedItem="{Binding SelectedBatchFile}" Height="128"
                                 Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </StackPanel>
                </Border>

                <!-- Назначение -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[OutputSectionLabel]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding LocalizedStrings[OutputBrowseButton]}"
                                    Command="{Binding BrowseOutputDirCommand}" MinWidth="120" MinHeight="30" Margin="8,0,0,0" FontSize="12.5"
                                    IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"/>
                            <TextBox Text="{Binding OutputDirectory}" MinHeight="30" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                    Visibility="{Binding ShowOutputFileName, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LocalizedStrings[OutputFileNameLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5" Width="128"/>
                            <TextBox Text="{Binding OutputFileName}" Width="222" MinHeight="29" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Кодирование -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[EncodingSectionLabel]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>

                        <UniformGrid Columns="3">
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,7">
                                <TextBlock Text="{Binding LocalizedStrings[ExtensionLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5"/>
                                <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,12,7" Visibility="{Binding ShowVideoEncoding, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LocalizedStrings[HardwareEncoderLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5"/>
                                <ComboBox ItemsSource="{Binding HardwareEncoders}" SelectedItem="{Binding SelectedHardwareEncoder}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" MinWidth="104" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7" Visibility="{Binding ShowVideoEncoding, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LocalizedStrings[PresetLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5"/>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" MinWidth="122" FontSize="12.5"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowVideoEncoding, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="{Binding LocalizedStrings[VideoCodecLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5"/>
                                <ComboBox ItemsSource="{Binding VideoCodecs}" SelectedItem="{Binding SelectedVideoCodec}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" MinWidth="172" FontSize="12.5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LocalizedStrings[AudioCodecLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5"/>
                                <ComboBox ItemsSource="{Binding AudioCodecs}" SelectedItem="{Binding SelectedAudioCodec}"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}" MinHeight="29" MinWidth="124" FontSize="12.5"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Качество -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowVideoEncoding, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <TextBlock Text="{Binding LocalizedStrings[CrfLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5"/>
                                <ui:NumberBox Value="{Binding Crf, UpdateSourceTrigger=PropertyChanged}" Width="auto" MaxWidth="130" MinHeight="29"
                                              Minimum="0" Maximum="51" SmallChange="1" ClearButtonEnabled="False"
                                              IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"
                                              ToolTip="{Binding LocalizedStrings[CrfHint]}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <TextBlock Text="{Binding LocalizedStrings[VideoBitrateLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5"/>
                                <ui:NumberBox Value="{Binding VideoBitrate, UpdateSourceTrigger=PropertyChanged}" Width="auto" MaxWidth="150" MinHeight="29"
                                              Minimum="0" SmallChange="100" ClearButtonEnabled="False"
                                              IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"
                                              ToolTip="{Binding LocalizedStrings[VideoBitrateHint]}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LocalizedStrings[AudioBitrateLabel]}" Style="{StaticResource FieldLabelText}" FontSize="12.5"/>
                            <ui:NumberBox Value="{Binding AudioBitrate, UpdateSourceTrigger=PropertyChanged}" Width="auto" MaxWidth="150" MinHeight="29"
                                          Minimum="0" SmallChange="32" ClearButtonEnabled="False"
                                          IsEnabled="{Binding IsConverting, Converter={StaticResource InvertBool}}"
                                          ToolTip="{Binding LocalizedStrings[AudioBitrateHint]}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Команда -->
                <Border Style="{StaticResource CardBorder}" Padding="12,9" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding LocalizedStrings[FfmpegCommandPreviewLabel]}" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                        <TextBox Text="{Binding FfmpegCommandPreview}" Height="44" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="9,7"
                                 VerticalScrollBarVisibility="Auto" AcceptsReturn="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Низ окна: прогресс + кнопки (вне прокрутки, всегда снизу) -->
        <StackPanel Grid.Row="2" Margin="16,8,16,10">
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Center" FontFamily="{StaticResource MonoLightFont}"
                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,2,7"
                       Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}"/>
            <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Style="{StaticResource RoundedProgressBar}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,4">
                <Button Content="{Binding LocalizedStrings[CancelConvertButton]}" Command="{Binding CancelConvertCommand}"
                        IsEnabled="{Binding IsCancellable}" Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVis}}"
                        MinWidth="132" Height="38" Margin="0,0,10,0" FontSize="13" FontWeight="SemiBold"/>
                <ui:Button Command="{Binding ConvertCommand}" MinWidth="216" Height="40" FontSize="14" FontWeight="SemiBold"
                           Appearance="Primary" CornerRadius="20">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="15"/>
                    </ui:Button.Icon>
                    <TextBlock Text="{Binding LocalizedStrings[ConvertButton]}" Margin="6,0,0,0"/>
                </ui:Button>
            </StackPanel>
        </StackPanel>

        <ui:ContentDialogHost x:Name="RootContentDialog" Grid.RowSpan="3" Panel.ZIndex="50"/>
    </Grid>
</ui:FluentWindow>
